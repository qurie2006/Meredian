# Groq API Configuration (Used by Meredian LLM Gateway & Local Hindsight)
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# Local Hindsight Configuration
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=your_groq_api_key_here
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b
# Set to "hindsight" (live HTTP/SDK against localhost:8888 with auto-fallback) or "local" (deterministic local engine)
MEREDIAN_MEMORY_BACKEND=hindsight

# Decision Policy Configuration
MEREDIAN_REPEAT_CONFIDENCE_THRESHOLD=0.75
MEREDIAN_RELATED_CONFIDENCE_THRESHOLD=0.45

# Band Configuration
BAND_MODE=mock
BAND_API_KEY=
BAND_ROOM_ID=payments-memleak-room
BAND_BASE_URL=https://api.band.ai

# API Server
MEREDIAN_API_HOST=127.0.0.1
MEREDIAN_API_PORT=8000
MEREDIAN_DB_PATH=meredian_state.db

